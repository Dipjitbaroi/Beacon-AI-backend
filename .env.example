# Copy this file to `.env` and fill in the real values.

# --- Database ---
DATABASE_URL=postgresql://user:pass@host:5432/civicdesk

# --- Server ---
PORT=8080
APP_URL=http://localhost:3000
PUBLIC_URL=https://api.civicdesk.yourdomain.com

# --- Auth ---
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=1d

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Email (SMTP) ---
# Gmail example: host smtp.gmail.com, port 587, secure false.
# Use an app password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace_with_an_app_password
SMTP_FROM="Beacon Reports <notifications@example.com>"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=civic-reports

# --- Duplicate detection weights & thresholds ---
# Composite = text * w_text + category * w_cat + geo * w_geo + time * w_time
DUP_TEXT_WEIGHT=0.55
DUP_CATEGORY_WEIGHT=0.15
DUP_GEO_WEIGHT=0.2
DUP_TIME_WEIGHT=0.1
DUP_RADIUS_M=500
DUP_LOOKBACK_DAYS=7
DUP_THRESHOLD=0.8

# --- Rate limiting (global limiter in app.ts) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
